# Копия этого файла -> .env (не коммитить .env!)

# Учётные данные Garmin Connect (нужны только при первом логине,
# после этого используется сохранённый токен и их можно удалить)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Где хранить токены авторизации Garmin (кэш сессии)
GARMIN_TOKENSTORE=./data/tokens

# Где хранить "библиотеку" файлов для загрузки в ChatGPT Project
LIBRARY_ROOT=./data/library

# Локальный кэш истории метрик (SQLite) для агрегации weekly/monthly
CACHE_DB_PATH=./data/cache.sqlite3

# --- BYOK/BYOM LLM (для cli chat/bot.py) ---------------------------------
# Всё, что говорит по OpenAI-совместимому протоколу /chat/completions.
# OpenRouter ушёл из РФ и больше не работает для российских пользователей без
# VPN - рекомендуемая замена для РФ: Cloud.ru Evolution Foundation Models
# (https://cloud.ru/docs/foundation-models/ug/topics/quickstart, ключ
# создаётся в личном кабинете, каталог моделей: DeepSeek/Qwen/GigaChat/Llama).
# Другие варианты: OpenAI, DeepSeek напрямую, локальный Ollama/LM Studio
# (напр. http://localhost:11434/v1, без API-ключа).
# Эти же поля можно задать через веб-форму /setup (там есть готовые пресеты
# провайдеров) - она пишет в data/config.json, который имеет приоритет над
# .env (см. garmin_pipeline/config.py).
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V3.1

# --- Telegram-бот (bot.py, только для дистрибутива, не нужен для CLI) ---
TELEGRAM_BOT_TOKEN=
# Если задан - бот отвечает только этому Telegram user id (числом), иначе всем
TELEGRAM_ALLOWED_USER_ID=
